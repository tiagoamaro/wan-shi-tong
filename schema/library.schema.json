{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wan-shi-tong.local/schema/library.schema.json",
  "title": "Wan Shi Tong library",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["kind", "title"],
    "additionalProperties": false,
    "properties": {
      "kind": { "enum": ["book", "movie"] },
      "title": { "type": "string", "minLength": 1 },
      "original_title": { "type": "string", "minLength": 1 },
      "creators": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "release_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "language": { "type": "string", "minLength": 1 },
      "series": { "type": "string", "minLength": 1 },
      "series_index": { "type": "number" },
      "labels": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "description": { "type": "string", "minLength": 1 },
      "imdb_id": { "type": "string", "minLength": 1 },
      "tmdb_id": { "type": "string", "minLength": 1 },
      "openlibrary_id": { "type": ["string", "null"], "minLength": 1 },
      "isbn": { "type": "string", "minLength": 1 },
      "external_url": { "type": "string", "pattern": "^https?://" },
      "image_path": { "type": "string", "minLength": 1 },
      "image_url": { "type": "string", "pattern": "^https?://" }
    }
  }
}
